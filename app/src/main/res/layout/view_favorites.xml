<?xml version="1.0" encoding="utf-8"?>
<!-- Son aramalarin ustundeki favoriler seridi. Baslik yerine sadece yildiz. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_favbar"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Yildiz ve hemen altinda siralamayi duzenleme dugmesi -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/favEdit"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="2dp"
            android:padding="5dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_edit"
            android:tint="@color/text_faint"
            android:scaleType="centerInside"
            android:contentDescription="Reorder favorites" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listFavorites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Duzenleme modunda cikar -->
    <TextView
        android:id="@+id/favSave"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_pill"
        android:text="Save"
        android:textSize="13sp"
        android:textColor="@color/gold"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</LinearLayout>
