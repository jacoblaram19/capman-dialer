<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/incallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_incall_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Arayan bilgisi -->
        <TextView
            android:id="@+id/stateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/state_incoming"
            android:textSize="13sp"
            android:textColor="@color/gold"
            android:letterSpacing="0.25"
            android:fontFamily="sans-serif-medium" />

        <FrameLayout
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_avatar">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="46sp"
                android:textColor="@color/gold"
                android:fontFamily="sans-serif-light" />

            <ImageView
                android:id="@+id/avatarPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/callerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textSize="27sp"
            android:textColor="@color/text"
            android:fontFamily="sans-serif-light"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/callerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/text_dim" />

        <!-- A one-line summary about the caller: "Calling for the first time" -->
        <TextView
            android:id="@+id/callerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/gold_soft"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Bu kisi icin kayitli not -->
        <TextView
            android:id="@+id/callerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_dim"
            android:textStyle="italic"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="@color/green"
            android:fontFamily="sans-serif-light"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recordingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_pill"
            android:text="● RECORDING"
            android:textSize="11sp"
            android:textColor="@color/red"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- Ayni anda iki cagri varsa: diger hatta kim var? -->
        <TextView
            android:id="@+id/otherCallInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/gold_soft"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ================= INCOMING CALL: the chomper strip ================= -->
        <LinearLayout
            android:id="@+id/incomingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Acmadan halletme yollari: hazir mesaj, ya da "sonra hatirlat" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/quickReply"
                    style="@style/IncomingPill"
                    android:text="Reject with\nmessage" />

                <TextView
                    android:id="@+id/rejectRemind"
                    style="@style/IncomingPill"
                    android:layout_marginStart="8dp"
                    android:text="Reject and\nremind me" />

                <TextView
                    android:id="@+id/silenceRemind"
                    style="@style/IncomingPill"
                    android:layout_marginStart="8dp"
                    android:text="Silence and\nremind me" />
            </LinearLayout>

            <com.capman.dialer.ChompSwipeView
                android:id="@+id/chomper"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginBottom="110dp" />
        </LinearLayout>

        <!-- ================= ACTIVE CALL ================= -->
        <LinearLayout
            android:id="@+id/activePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/actMute" style="@style/CallAction">
                    <ImageView android:id="@+id/actMuteIcon" style="@style/CallActionIcon"
                        android:src="@drawable/ic_mic_off" />
                    <TextView android:id="@+id/actMuteLabel" style="@style/CallActionLabel"
                        android:text="Mute" />
                </LinearLayout>

                <LinearLayout android:id="@+id/actKeypad" style="@style/CallAction">
                    <ImageView android:id="@+id/actKeypadIcon" style="@style/CallActionIcon"
                        android:src="@drawable/ic_dialpad" />
                    <TextView style="@style/CallActionLabel" android:text="Keypad" />
                </LinearLayout>

                <LinearLayout android:id="@+id/actSpeaker" style="@style/CallAction">
                    <ImageView android:id="@+id/actSpeakerIcon" style="@style/CallActionIcon"
                        android:src="@drawable/ic_speaker" />
                    <!-- A Bluetooth device name can be long; keep it on one line -->
                    <TextView android:id="@+id/actSpeakerLabel" style="@style/CallActionLabel"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Speaker" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <LinearLayout android:id="@+id/actNote" style="@style/CallAction">
                    <ImageView style="@style/CallActionIcon" android:src="@drawable/ic_note" />
                    <TextView style="@style/CallActionLabel" android:text="Add note" />
                </LinearLayout>

                <LinearLayout android:id="@+id/actHold" style="@style/CallAction">
                    <ImageView android:id="@+id/actHoldIcon" style="@style/CallActionIcon"
                        android:src="@drawable/ic_pause" />
                    <TextView android:id="@+id/actHoldLabel" style="@style/CallActionLabel"
                        android:text="Hold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/actInfo" style="@style/CallAction">
                    <ImageView style="@style/CallActionIcon" android:src="@drawable/ic_info" />
                    <TextView style="@style/CallActionLabel" android:text="Contact" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ses kaydi yalnizca gercekten calisabiliyorsa (root/priv-app) gorunur -->
            <LinearLayout
                android:id="@+id/recordRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout android:id="@+id/actRecord" style="@style/CallAction">
                    <ImageView android:id="@+id/actRecordIcon" style="@style/CallActionIcon"
                        android:src="@drawable/ic_record" />
                    <TextView android:id="@+id/actRecordLabel" style="@style/CallActionLabel"
                        android:text="Record" />
                </LinearLayout>

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/hangup"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_end_button"
                android:src="@drawable/ic_call_end"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:elevation="6dp"
                android:contentDescription="Close" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= WHATSAPP KISAYOLU =================
         WhatsApp profil fotografini disaridan okumak mumkun degil (WhatsApp
         fotografi rehbere yazmiyor, disariya acik bir avatar saglayicisi da yok).
         Onun yerine kose rozeti, arayanin WhatsApp sohbetine gitme kisayolu:
         tanimadigin numarayi oradan bakip taniyabiliyorsun. -->
    <LinearLayout
        android:id="@+id/waBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_row"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_circle_green">

            <ImageView
                android:id="@+id/waIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_whatsapp"
                android:tint="@color/green"
                android:padding="15dp"
                android:contentDescription="WhatsApp" />

            <ImageView
                android:id="@+id/waPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="WhatsApp"
            android:textSize="9sp"
            android:textColor="@color/text_faint"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Cagri acilinca yesil hedeften kirmizi "kapat" dugmesine donusen daire -->
    <View
        android:id="@+id/morphBubble"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:elevation="8dp"
        android:visibility="gone" />

    <!-- ================= IN-CALL KEYPAD ================= -->
    <include
        android:id="@+id/incallKeypad"
        layout="@layout/view_incall_keypad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
