<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Ust arama cubugu: uygulama acilir acilmaz parmak menzilinde,
         tek dokunusla isim yazmaya baslanabiliyor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text_faint"
                android:contentDescription="@string/search_hint" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textSize="15sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="4dp" />

            <ImageButton
                android:id="@+id/searchClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_key"
                android:src="@drawable/ic_close"
                android:tint="@color/text_dim"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@string/cancel" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/addContact"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_gold"
            android:src="@drawable/ic_person_add"
            android:tint="@color/gold"
            android:scaleType="centerInside"
            android:contentDescription="@string/new_contact" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="54dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_faint"
            android:scaleType="centerInside"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Favoriler seridi: yalnizca gecmis sekmesinde ve arama yapilmiyorken -->
    <include
        android:id="@+id/favoritesBar"
        layout="@layout/view_favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Gecmis suzgeci: tumu / geri donulmemis cevapsizlar -->
    <LinearLayout
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView android:id="@+id/chipAll" style="@style/FilterChip" android:text="All" />

        <TextView
            android:id="@+id/chipMissed"
            style="@style/FilterChip"
            android:layout_marginStart="8dp"
            android:text="Missed" />
    </LinearLayout>

    <!-- Icerik -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:paddingEnd="22dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Rehberde sag kenardaki alfabe seridi: harfe dokun/kaydir, o bolume atla.
             Harfler kod tarafinda ekleniyor (Turkce alfabe + "#"). -->
        <LinearLayout
            android:id="@+id/alphaIndex"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="14dp"
            android:visibility="gone" />

        <!-- Kaydirirken ortada gorunen buyuk harf -->
        <TextView
            android:id="@+id/alphaPreview"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/bg_avatar"
            android:textSize="36sp"
            android:textColor="@color/gold"
            android:fontFamily="sans-serif-light"
            android:elevation="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/dialpad"
            layout="@layout/view_dialpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_faint"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Alt sekmeler -->
    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tabbar">

        <LinearLayout android:id="@+id/tabRecents" style="@style/TabItem">
            <ImageView
                android:id="@+id/tabRecentsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                android:tint="@color/gold" />
            <TextView
                android:id="@+id/tabRecentsLabel"
                style="@style/TabLabel"
                android:text="@string/tab_recents"
                android:textColor="@color/gold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabContacts" style="@style/TabItem">
            <ImageView
                android:id="@+id/tabContactsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_contacts"
                android:tint="@color/text_faint" />
            <TextView
                android:id="@+id/tabContactsLabel"
                style="@style/TabLabel"
                android:text="@string/tab_contacts"
                android:textColor="@color/text_faint" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tabDialpad" style="@style/TabItem">
            <ImageView
                android:id="@+id/tabDialpadIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_dialpad"
                android:tint="@color/text_faint" />
            <TextView
                android:id="@+id/tabDialpadLabel"
                style="@style/TabLabel"
                android:text="@string/tab_dialpad"
                android:textColor="@color/text_faint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
