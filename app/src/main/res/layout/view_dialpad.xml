<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:visibility="gone">

    <!-- Yazilan numara -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/dialNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="32sp"
            android:textColor="@color/text"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:ellipsize="start"
            android:minHeight="52dp"
            android:textIsSelectable="true" />

        <ImageButton
            android:id="@+id/dialBackspace"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_backspace"
            android:tint="@color/text_dim"
            android:scaleType="centerInside"
            android:visibility="invisible"
            android:contentDescription="Delete" />
    </LinearLayout>

    <!-- Panoda numara varsa tek dokunusla yapistir -->
    <TextView
        android:id="@+id/clipSuggest"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/bg_pill"
        android:textSize="13sp"
        android:textColor="@color/gold"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="middle"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Yazdikca eslesen kisiler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialMatches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <!-- Tuslar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="288dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout style="@style/DialRow">
            <LinearLayout android:id="@+id/key1" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="1" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>
            <LinearLayout android:id="@+id/key2" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="2" />
                <TextView style="@style/DialLetters" android:text="ABC" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key3" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="3" />
                <TextView style="@style/DialLetters" android:text="DEF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/DialRow">
            <LinearLayout android:id="@+id/key4" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="4" />
                <TextView style="@style/DialLetters" android:text="GHI" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key5" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="5" />
                <TextView style="@style/DialLetters" android:text="JKL" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key6" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="6" />
                <TextView style="@style/DialLetters" android:text="MNO" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/DialRow">
            <LinearLayout android:id="@+id/key7" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="7" />
                <TextView style="@style/DialLetters" android:text="PQRS" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key8" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="8" />
                <TextView style="@style/DialLetters" android:text="TUV" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key9" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="9" />
                <TextView style="@style/DialLetters" android:text="WXYZ" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/DialRow">
            <LinearLayout android:id="@+id/keyStar" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="*" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>
            <LinearLayout android:id="@+id/key0" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="0" />
                <TextView style="@style/DialLetters" android:text="+" />
            </LinearLayout>
            <LinearLayout android:id="@+id/keyHash" style="@style/DialKey">
                <TextView style="@style/DialDigit" android:text="#" />
                <TextView style="@style/DialLetters" android:text=" " />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Ara / kaydet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp">

        <ImageButton
            android:id="@+id/dialSaveContact"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="34dp"
            android:background="@drawable/bg_circle_surface"
            android:src="@drawable/ic_person_add"
            android:tint="@color/text_dim"
            android:scaleType="centerInside"
            android:visibility="invisible"
            android:contentDescription="@string/new_contact" />

        <ImageButton
            android:id="@+id/dialCall"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_call_button"
            android:src="@drawable/ic_phone"
            android:tint="#0A2C1E"
            android:scaleType="centerInside"
            android:elevation="6dp"
            android:contentDescription="@string/call" />
    </FrameLayout>
</LinearLayout>
