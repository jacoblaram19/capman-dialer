<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_key"
            android:src="@drawable/ic_close"
            android:tint="@color/text"
            android:scaleType="centerInside"
            android:contentDescription="@string/cancel" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            android:textColor="@color/text"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/avatarBox"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_avatar"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="34sp"
                    android:textColor="@color/gold"
                    android:fontFamily="sans-serif-light" />

                <ImageView
                    android:id="@+id/avatarPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/changePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                android:text="Choose photo"
                android:textSize="13sp"
                android:textColor="@color/gold"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <!-- Yalnizca fotografi olan kisilerde gorunur -->
            <TextView
                android:id="@+id/removePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:padding="8dp"
                android:text="Remove photo"
                android:textSize="13sp"
                android:textColor="@color/red"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="FULL NAME"
                android:textSize="11sp"
                android:textColor="@color/gold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/name_hint"
                android:textSize="17sp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingBottom="8dp"
                android:text="PHONE NUMBERS"
                android:textSize="11sp"
                android:textColor="@color/gold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/numbersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Kisiye ozel zil sesi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingBottom="8dp"
                android:text="RINGTONE"
                android:textSize="11sp"
                android:textColor="@color/gold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/ringtoneRow"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/gold"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/ringtoneLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Default ringtone"
                    android:textSize="15sp"
                    android:textColor="@color/text"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_expand_more"
                    android:tint="@color/text_faint"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/accountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingBottom="8dp"
                android:text="SAVE TO"
                android:textSize="11sp"
                android:textColor="@color/gold"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/accountRow"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/accountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/text" />

                    <TextView
                        android:id="@+id/accountHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/text_faint" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    android:tint="@color/text_faint"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/addNumber"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:background="@drawable/bg_pill"
                android:text="@string/add_number"
                android:textSize="14sp"
                android:textColor="@color/gold"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="18dp"
        android:gravity="center"
        android:background="@drawable/bg_gold_button"
        android:text="@string/save"
        android:textSize="16sp"
        android:textColor="#20180A"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
