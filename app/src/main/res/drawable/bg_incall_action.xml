<?xml version="1.0" encoding="utf-8"?>
<!-- Maske sart: olmazsa basma efekti dairenin disina tasip kare cerceve gibi gorunuyor -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/overlay" />
            <stroke android:width="1dp" android:color="@color/overlay_stroke" />
        </shape>
    </item>
</ripple>
